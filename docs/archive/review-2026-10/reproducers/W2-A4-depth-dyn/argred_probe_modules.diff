+#[cfg(all(test, feature = "unbounded-ladder"))]
+mod a4_table {
+    extern crate std;
+    use super::*;
+    use ferrodec_multiword::bigconst;
+    use std::println;
+    #[test]
+    fn a4_whole_table_vs_generator() {
+        let n = table::TWO_OVER_PI_DIGITS as u64;
+        let d = bigconst::two_over_pi_digits(n);
+        let s = std::format!("{d}");
+        assert_eq!(s.len() as u64, n);
+        let mut mism = 0;
+        let mut tabs = std::string::String::new();
+        for (i, ch) in s.bytes().enumerate() {
+            let t = two_over_pi_digit(i + 1);
+            tabs.push((b'0' + t) as char);
+            if t != ch - b'0' { mism += 1; println!("MISMATCH digit {}", i + 1); }
+        }
+        std::fs::write(std::env::var("A4_TABLE_OUT").unwrap(), tabs).unwrap();
+        println!("TABLE compared {} digits, {} mismatches", s.len(), mism);
+    }
+}
