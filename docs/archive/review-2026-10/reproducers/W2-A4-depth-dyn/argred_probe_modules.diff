+mod a4_probe_sc {
+    extern crate std;
+    use super::*;
+    use crate::mock_format::ValueFmt128;
+    use std::println;
+
+    #[test]
+    fn a4_sincos_dump() {
+        let deep: [(u128, i32); 4] = [
+            (9308532438209917461067659354862169, 4639),
+            (2344813655066356855719930664718056, 1381),
+            (6979794724988577187926241954295594, 2278),
+            (4272221537462525975023616239425960, 5981),
+        ];
+        for (c, q) in deep {
+            for neg in [false, true] {
+                let x = ValueFmt128 { coef: c, exp: q, sign: neg };
+                let (s2, c2, _) = crate::sincos::sincos_extended_body::<ValueFmt128, crate::extended2::Extended2>(crate::extended2::Extended2::ZERO, x);
+                println!("SC2 {c} {q} {neg} S sign={} coef={} exp={}", s2.sign, super::a4_probe::u384s_pub(s2.coef), s2.exp);
+                println!("SC2 {c} {q} {neg} C sign={} coef={} exp={}", c2.sign, super::a4_probe::u384s_pub(c2.coef), c2.exp);
+                for p in [110u32, 220, 440, 880, 1760] {
+                    let a = crate::extended_dyn::DynArena::new(p);
+                    let (sd, cd, _) = crate::sincos::sincos_extended_body::<ValueFmt128, _>(a.exemplar(), x);
+                    println!("SCD{p} {c} {q} {neg} S {sd:?}");
+                    println!("SCD{p} {c} {q} {neg} C {cd:?}");
+                }
+            }
+        }
+    }
+}
